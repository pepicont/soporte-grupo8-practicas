# Modelo Whisper MLX local (repo HF dentro de ~/AI). Opciones descargadas:
#   mlx-community/whisper-large-v3-turbo  (rápido + preciso, recomendado)
#   mlx-community/whisper-large-v3-mlx
#   mlx-community/whisper-medium-mlx
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
# Idioma del audio (ISO 639-1). Vacío = autodetectar.
WHISPER_LANG=es
