#:kivy 2.0

<CalculatorRoot>:
    orientation: "vertical"
    padding: 16
    spacing: 12
    canvas.before:
        Color:
            rgba: 0.06, 0.06, 0.08, 1
        Rectangle:
            pos: self.pos
            size: self.size

    # ── Display ──────────────────────────────────────────────────────────────
    BoxLayout:
        orientation: "vertical"
        size_hint_y: 0.28
        padding: [20, 12]
        spacing: 4
        canvas.before:
            Color:
                rgba: 0.10, 0.10, 0.13, 1
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [16]

        Label:
            text: root.display_expr
            font_size: "15sp"
            color: 0.50, 0.55, 0.60, 1
            halign: "right"
            valign: "bottom"
            text_size: self.size
            size_hint_y: 0.35

        Label:
            text: root.display_result
            font_size: "40sp"
            bold: True
            color: 0.95, 0.95, 0.95, 1
            halign: "right"
            valign: "middle"
            text_size: self.size
            size_hint_y: 0.65

    # ── Teclado ───────────────────────────────────────────────────────────────
    GridLayout:
        cols: 4
        spacing: 10
        size_hint_y: 0.72

        # fila 1
        CalcButton:
            text: "AC"
            base_color: 0.55, 0.18, 0.22, 1
            on_release: root.press_ac()

        CalcButton:
            text: "+/-"
            base_color: 0.30, 0.20, 0.50, 1
            on_release: root.press_sign()

        CalcButton:
            text: "DEL"
            base_color: 0.30, 0.20, 0.50, 1
            on_release: root.press_back()

        CalcButton:
            text: "/"
            base_color: 0.18, 0.35, 0.55, 1
            on_release: root.press_op("/")

        # fila 2
        CalcButton:
            text: "7"
            base_color: 0.15, 0.15, 0.20, 1
            on_release: root.press_digit("7")

        CalcButton:
            text: "8"
            base_color: 0.15, 0.15, 0.20, 1
            on_release: root.press_digit("8")

        CalcButton:
            text: "9"
            base_color: 0.15, 0.15, 0.20, 1
            on_release: root.press_digit("9")

        CalcButton:
            text: "x"
            base_color: 0.18, 0.35, 0.55, 1
            on_release: root.press_op("x")

        # fila 3
        CalcButton:
            text: "4"
            base_color: 0.15, 0.15, 0.20, 1
            on_release: root.press_digit("4")

        CalcButton:
            text: "5"
            base_color: 0.15, 0.15, 0.20, 1
            on_release: root.press_digit("5")

        CalcButton:
            text: "6"
            base_color: 0.15, 0.15, 0.20, 1
            on_release: root.press_digit("6")

        CalcButton:
            text: "-"
            base_color: 0.18, 0.35, 0.55, 1
            on_release: root.press_op("-")

        # fila 4
        CalcButton:
            text: "1"
            base_color: 0.15, 0.15, 0.20, 1
            on_release: root.press_digit("1")

        CalcButton:
            text: "2"
            base_color: 0.15, 0.15, 0.20, 1
            on_release: root.press_digit("2")

        CalcButton:
            text: "3"
            base_color: 0.15, 0.15, 0.20, 1
            on_release: root.press_digit("3")

        CalcButton:
            text: "+"
            base_color: 0.18, 0.35, 0.55, 1
            on_release: root.press_op("+")

        # fila 5 — el 0 ocupa 2 columnas

        CalcButton:
            text: "."
            base_color: 0.15, 0.15, 0.20, 1
            on_release: root.press_dot()

        CalcButton:
            text: "0"
            base_color: 0.15, 0.15, 0.20, 1
            on_release: root.press_digit("0")    

        CalcButton:
            text: "ANS"
            base_color: 0.30, 0.20, 0.50, 1
            on_release: root.press_ans()    

        CalcButton:
            text: "="
            base_color: 0.20, 0.65, 0.50, 1
            on_release: root.press_equal()


# ── Widget de botón reutilizable ─────────────────────────────────────────────
<CalcButton@Button>:
    base_color: 0.15, 0.15, 0.20, 1
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    color: 0.95, 0.95, 0.95, 1
    font_size: "22sp"
    bold: True
    canvas.before:
        Color:
            rgba: self.base_color if self.state == "normal" else [min(c+0.15,1) for c in self.base_color]
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [14]
